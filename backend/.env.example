# Copy to .env for local development (.env is gitignored).
# In production (Render, Railway) set these as service environment variables instead.

# JDBC URL of the database. MySQL and PostgreSQL are both supported.
# Local MySQL:
DATABASE_URL=jdbc:mysql://localhost:3306/cyberincident?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# Supabase (use the Session pooler host from the Connect dialog):
# DATABASE_URL=jdbc:postgresql://aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DB_USER=your-db-user
DB_PASSWORD=your-db-password
# Older names MYSQLUSER and MYSQLPASSWORD still work.

# Required, at least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=replace-with-a-generated-secret

# Comma-separated browser origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional
PORT=8080
UPLOAD_DIR=uploads/evidence
DB_POOL_SIZE=5
